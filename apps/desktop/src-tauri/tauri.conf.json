{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Drivward",
  "version": "0.1.0",
  "identifier": "xyz.sacortech.drivward",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Drivward",
        "width": 1040,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Cuida los drivers de tu compu",
    "longDescription": "Drivward vigila los drivers y la estabilidad del equipo, recomienda cambios y permite volver a la versión anterior.",
    "copyright": "GPL-3.0 · Sacor Tech",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": { "../../../target/release/drivward-service.exe": "drivward-service.exe" },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["Spanish", "English"],
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
